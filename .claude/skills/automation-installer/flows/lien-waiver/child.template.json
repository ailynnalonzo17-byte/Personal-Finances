  {
   "id": "lw2-compose-proposal",
   "name": "Compose Proposal",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    3540,
    -120
   ],
   "parameters": {
    "jsCode": "\n// The Slack message IS the review. Show every value exactly as it will print on the waiver,\n// so nobody has to open DocuSign to check it.\nconst j = $('Build Waiver').first().json;\nconst envId = $input.first().json.envelopeId;\nif (!envId) { throw new Error('DocuSign returned no envelopeId'); }\nconst t = j.tabs;\nconst money = t['Amount of Check'] ? ('$' + Number(t['Amount of Check']).toLocaleString('en-US',\n  { minimumFractionDigits: 2, maximumFractionDigits: 2 })) : '';\nconst nl = String.fromCharCode(10);\nconst text = [\n  ':page_facing_up: *Lien waiver ready to send* - ' + j.vendorName,\n  '_' + j.issue + '_',\n  '',\n  '*Claimant:* ' + t['Check Payable To'],\n  '*Customer:* ' + t['Name of Customer'],\n  '*Owner:* ' + t['Owner'],\n  '*Job location:* ' + t['Job Location'],\n  '*Maker of check:* ' + t['Maker of Check'],\n  '*Amount of check:* ' + money,\n  '*Through date:* ' + t['Through Date'],\n  '*Exceptions:* ' + t['Exceptions'],\n  '',\n  'Goes to ' + j.vendorEmail + '  \u00b7  <https://app.docusign.com/documents/details/' + envId + '|view in DocuSign>'\n].join(nl);\nreturn [{ json: { text, envelopeId: envId, recId: j.recId, vendorName: j.vendorName, vendorEmail: j.vendorEmail } }];\n"
   }
  },
  {
   "id": "lw2-post-proposal",
   "name": "Post Proposal",
   "type": "n8n-nodes-base.slack",
   "typeVersion": 2.5,
   "position": [
    3740,
    -120
   ],
   "parameters": {
    "authentication": "accessToken",
    "resource": "message",
