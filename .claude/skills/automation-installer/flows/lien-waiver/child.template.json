  {
   "id": "lw2-jwt-read",
   "name": "JWT (read)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1740,
    -120
   ],
   "parameters": {
    "jsCode": "const crypto = require(\"crypto\");\nconst INTEGRATION_KEY = \"%%VAO::VAR::DOCUSIGN_INTEGRATION_KEY%%\";\nconst USER_ID = \"%%VAO::VAR::DOCUSIGN_USER_ID%%\";\nconst PRIVATE_KEY = \"%%VAO::VAR::DOCUSIGN_PRIVATE_KEY%%\";\nconst now = Math.floor(Date.now()/1000);\nconst header = Buffer.from(JSON.stringify({ alg: \"RS256\", typ: \"JWT\" })).toString(\"base64url\");\nconst payload = Buffer.from(JSON.stringify({ iss: INTEGRATION_KEY, sub: USER_ID, aud: \"account.docusign.com\", iat: now, exp: now+3600, scope: \"signature impersonation\" })).toString(\"base64url\");\nconst signingInput = header + \".\" + payload;\nconst signer = crypto.createSign(\"RSA-SHA256\");\nsigner.update(signingInput);\nconst signature = signer.sign(PRIVATE_KEY).toString(\"base64url\");\nreturn [{ json: { assertion: signingInput + \".\" + signature } }];"
   }
  },
