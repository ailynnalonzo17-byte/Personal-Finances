   ],
   "parameters": {
    "jsCode": "\nconst recs = ($input.first().json.records) || [];\nif (!recs.length) { throw new Error('Maintenance record not found: ' + $('When Called').first().json.recordId); }\nconst r = recs[0];\nconst one = (v) => (v || [])[0] || '';\nconst job = {\n  recId: r.id,\n  issue: r.fields['Issue'] || '',\n  propertyId: one(r.fields['Property']),\n  unitId: one(r.fields['Unit']),\n  vendorId: one(r.fields['Vendor']),\n  invoiceAmount: r.fields['Invoice Amount'],\n  completedDate: r.fields['Completed Date'] || '',\n  exceptions: (r.fields['Lien Waiver Exceptions'] || '').trim()\n};\nconst idF = (id) => id ? (\"RECORD_ID()='\" + id + \"'\") : \"RECORD_ID()='none'\";\nreturn [{ json: { job, propertyFormula: idF(job.propertyId), unitFormula: idF(job.unitId), vendorFormula: idF(job.vendorId) } }];\n"
   }
  },
