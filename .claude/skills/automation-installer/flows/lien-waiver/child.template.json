  },
  {
   "id": "lw2-map-tabs",
   "name": "Map Tabs",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    3140,
    -120
   ],
   "parameters": {
    "jsCode": "\nconst cfg = $('Config').first().json;\nconst j = $('Build Waiver').first().json;\nconst signers = ($input.first().json.signers) || [];\nconst role = signers.find(s => s.roleName === cfg.roleName) || signers[0];\nif (!role) { throw new Error('Template has no signer role named ' + cfg.roleName); }\nconst byTooltip = {};\nconst tabs = role.tabs || {};\nfor (const k of Object.keys(tabs)) {\n  const arr = tabs[k];\n  if (!Array.isArray(arr)) { continue; }\n  for (const t of arr) { if (t.tooltip && t.tabLabel) { byTooltip[String(t.tooltip).trim()] = t.tabLabel; } }\n}\nconst textTabs = []; const unmapped = [];\nfor (const tip of Object.keys(j.tabs)) {\n  const label = byTooltip[tip];\n  if (!label) { unmapped.push(tip); continue; }\n  textTabs.push({ tabLabel: label, value: String(j.tabs[tip]), locked: 'true' });\n}\nif (unmapped.length) { throw new Error('Template is missing a tooltip for: ' + unmapped.join(', ')); }\nreturn [{ json: { envelope: {\n  status: 'created',\n  emailSubject: 'Conditional Lien Waiver - ' + j.vendorName + ' - ' + j.tabs['Job Location'],\n  templateId: $('Pick Template').first().json.templateId,\n  templateRoles: [{ roleName: cfg.roleName, name: j.vendorName, email: j.vendorEmail, tabs: { textTabs } }]\n} } }];\n"
   }
  },
  {
