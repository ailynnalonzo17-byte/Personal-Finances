   "parameters": {
    "jsCode": "const ui=$input.first().json;\nconst accts=ui.accounts||[];\nconst acct=accts.find(a=>a.is_default===true||a.is_default==='true')||accts[0]||{};\nif(!acct.base_uri||!acct.account_id){throw new Error('DocuSign userinfo returned no account base_uri/account_id');}\nreturn [{ json: { base_uri: acct.base_uri, account_id: acct.account_id } }];"
   }
