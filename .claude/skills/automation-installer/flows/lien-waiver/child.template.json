  {
   "id": "lw2-pick-template",
   "name": "Pick Template",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2740,
    -120
   ],
   "parameters": {
    "jsCode": "\nconst want = $('Config').first().json.templateName;\nconst list = ($input.first().json.envelopeTemplates) || [];\nconst hit = list.find(t => t.name === want) || list[0];\nif (!hit) { throw new Error('No DocuSign template found matching: ' + want); }\nreturn [{ json: { templateId: hit.templateId, templateName: hit.name } }];\n"
   }
  },
  {
   "id": "lw2-get-template-tabs",
   "name": "Get Template Tabs",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.4,
   "position": [
    2940,
    -120
   ],
   "parameters": {
    "method": "GET",
    "url": "={{ $('Resolve DocuSign Account').first().json.base_uri }}/restapi/v2.1/accounts/{{ $('Resolve DocuSign Account').first().json.account_id }}/templates/{{ $json.templateId }}/recipients",
    "sendQuery": true,
    "specifyQuery": "keypair",
    "queryParameters": {
     "parameters": [
      {
       "name": "include_tabs",
       "value": "true"
      }
     ]
    },
    "sendHeaders": true,
    "specifyHeaders": "keypair",
    "headerParameters": {
