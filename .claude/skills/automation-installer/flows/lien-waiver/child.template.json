  {
   "id": "lw2-build-waiver",
   "name": "Build Waiver",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1340,
    0
   ],
   "parameters": {
    "jsCode": "\nconst j = $('Plan Lookups').first().json.job;\nconst p = (($('Get Property').first().json.records || [])[0] || {}).fields || {};\nconst u = (($('Get Unit').first().json.records || [])[0] || {}).fields || {};\nconst v = (($('Get Vendor').first().json.records || [])[0] || {}).fields || {};\nconst mgrs = {}; for (const r of ($('Get Managers').first().json.records || [])) { mgrs[r.id] = r.fields; }\nconst pm = mgrs[((p['Property Manager'] || [])[0]) || ''] || {};\n\nconst money = (n) => { if (n === null || n === undefined || n === '') { return ''; }\n  const x = Number(n); if (!isFinite(x)) { return ''; } return x.toFixed(2); };\nconst usDate = (iso) => { if (!iso) { return ''; } const a = String(iso).slice(0,10).split('-');\n  return a.length === 3 ? (a[1] + '/' + a[2] + '/' + a[0]) : ''; };\n\nconst ownerEntity = (p['Owner Entity'] || '').trim();\nconst payer = (pm['Vendor Name'] || '').trim() || ownerEntity;\nconst st = p['State (Select)'];\nconst stateStr = (st && typeof st === 'object') ? (st.name || '') : (st || '');\nconst parts = [];\nif (p['Street Address']) { parts.push(String(p['Street Address']).trim()); }\nif (u['Unit'])           { parts.push(String(u['Unit']).trim()); }\nif (p['Town'])           { parts.push(String(p['Town']).trim()); }\nlet jobLocation = parts.join(', ');\nif (stateStr) { jobLocation = jobLocation + ', ' + stateStr; }\n\nconst vendorName = (v['Vendor Name'] || '').trim();\nconst vendorEmail = (v['Email'] || '').trim();\nconst amount = money(j.invoiceAmount);\nconst through = usDate(j.completedDate);\n\nconst missing = [];\nif (!vendorName) { missing.push('Vendor'); }\nif (!vendorEmail) { missing.push('Vendor email'); }\nif (!amount) { missing.push('Invoice Amount'); }\nif (!through) { missing.push('Completed Date'); }\nif (!p['Street Address']) { missing.push('Property address'); }\nif (!p['Town']) { missing.push('Town on the property'); }\nif (!stateStr) { missing.push('State on the property'); }\nif (!ownerEntity) { missing.push('Owner Entity on the property'); }\nif (!payer) { missing.push('Property Manager or Owner Entity'); }\n\nreturn [{ json: {\n  ok: missing.length === 0, missing: missing.join(', '),\n  recId: j.recId, issue: j.issue, vendorName, vendorEmail, amount, through,\n  tabs: { 'Name of Customer': payer, 'Job Location': jobLocation, 'Owner': ownerEntity,\n          'Through Date': through, 'Maker of Check': payer, 'Amount of Check': amount,\n          'Check Payable To': vendorName, 'Exceptions': j.exceptions || 'None' }\n} }];\n"
   }
  },
